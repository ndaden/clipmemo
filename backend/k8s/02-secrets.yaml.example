apiVersion: v1
kind: Secret
metadata:
  name: clipmemo-secrets
  namespace: clipmemo
type: Opaque
stringData:
  # Clé secrète Google AI Studio
  GEMINI_API_KEY: "<REMPLACER>"
  # Clé d'application pour X-App-Key.
  # Générer une valeur aléatoire, par exemple : openssl rand -hex 32
  # Ne jamais committer de valeur réelle : ce fichier est un exemple public.
  APP_SECRET_KEY: "<REMPLACER>"
