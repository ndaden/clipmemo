# Server configuration
PORT=3000
HOST=0.0.0.0

# Google Gemini API Key (Secret, kept exclusively on server)
GEMINI_API_KEY=your_gemini_api_key_here

# App Secret Key to authenticate requests from ClipMemo app (X-App-Key header)
# Generate a secure random string or leave blank in local dev
APP_SECRET_KEY=clipmemo_secret_app_key_2026

# Model selection (default: gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
