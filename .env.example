# ==============================================================================
# ClipMemo - Modèle de Configuration d'Environnement (.env.example)
# ==============================================================================
# Ce fichier recense l'ensemble des variables et secrets requis pour le projet :
# 1. GitHub Secrets (CI/CD GitHub Actions & Déploiement k3s / Build Android)
# 2. Variables du Backend Proxy Fastify (backend/.env ou conteneur)
# 3. Variables de l'Application Android (local.properties ou variables système)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GITHUB SECRETS (À renseigner dans GitHub : Settings > Secrets > Actions)
# ------------------------------------------------------------------------------

# [IDENTIQUE À QUIZZY] Fichier Kubeconfig de votre cluster k3s encodé en base64
# Pour l'obtenir : cat /etc/rancher/k3s/k3s.yaml | sed "s/127.0.0.1/<IP_VPS>/g" | base64 -w 0
KUBECONFIG="<votre_kubeconfig_encode_en_base64>"

# [IDENTIQUE À QUIZZY] Personal Access Token GitHub (PAT) avec le scope 'read:packages'
# Permet au cluster k3s de télécharger l'image conteneur depuis ghcr.io
GHCR_PULL_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clé API Google AI Studio (Gemini)
# Obtenez une clé gratuitement sur : https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Clé secrète partagée d'application (utilisée pour le header X-App-Key)
# Permet de réserver l'accès au backend proxy uniquement à votre application
APP_SECRET_KEY="clipmemo_secret_app_key_2026_change_me"

# (Optionnel) URL HTTPS publique de production du backend proxy
# Par défaut dans les workflows : https://clipmemo.dnabil.ovh
BACKEND_BASE_URL="https://clipmemo.dnabil.ovh"


# ------------------------------------------------------------------------------
# 2. BACKEND PROXY (backend/.env pour exécution locale : cd backend && npm run dev)
# ------------------------------------------------------------------------------
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# Clé API Gemini et Clé de protection proxy (identiques aux valeurs ci-dessus)
# GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# APP_SECRET_KEY="clipmemo_secret_app_key_2026_change_me"

# Modèles Gemini utilisés (avec repli automatique en cas de quota 429)
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"


# ------------------------------------------------------------------------------
# 3. APPLICATION ANDROID (local.properties pour le développement sous Android Studio)
# ------------------------------------------------------------------------------
# Dans le fichier local.properties à la racine du projet :
#
# Pour pointer vers votre serveur local depuis l'émulateur Android :
# backend.base.url=http://10.0.2.2:3000
# backend.app.key=clipmemo_secret_app_key_2026_change_me
#
# Pour pointer vers le serveur de production déployé sur k3s :
# backend.base.url=https://clipmemo.dnabil.ovh
# backend.app.key=clipmemo_secret_app_key_2026_change_me
